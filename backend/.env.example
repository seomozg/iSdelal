# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ============================================
# Jina AI API (for embeddings)
# Get your key at: https://jina.ai/embeddings/
# ============================================
JINA_API_KEY=jina_your-key-here

# ============================================
# DeepSeek API (for LLM responses)
# Get your key at: https://platform.deepseek.com/api_keys
# ============================================
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ============================================
# Backend Service
# ============================================
PROJECT_HOST=0.0.0.0
PROJECT_PORT=8000

# ============================================
# Embeddings & RAG
# ============================================
EMBED_MODEL=jina-embeddings-v2-base-en
RAG_TOP_K=5

# ============================================
# Web Crawling
# ============================================
CRAWL_MAX_PAGES=50
PLAYWRIGHT_MAX_PAGES=30
CRAWL_TIMEOUT=30
USE_PLAYWRIGHT=true

# ============================================
# Frontend/Client Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=change-this-to-a-random-string-in-production

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./data/isdelal.db

# ============================================
# YooKassa (coming soon)
# ============================================
# YOOKASSA_SHOP_ID=your-shop-id
# YOOKASSA_SECRET_KEY=your-secret-key

# ============================================
# Telegram Bot (optional — RAG chat in Telegram)
# Get a token from @BotFather: https://t.me/BotFather
# Deep link for binding a chat to a collection:
#   https://t.me/<bot_username>?start=<collection_name>
# ============================================
TG_BOT_TOKEN=
# Daily message limit per chat (0 = disabled)
TG_DAILY_LIMIT=50
# Max concurrent answers (default 4)
TG_MAX_CONCURRENT=4
# Answer timeout in seconds (default 120)
TG_ANSWER_TIMEOUT=120

